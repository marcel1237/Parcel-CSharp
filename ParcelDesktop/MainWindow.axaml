<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ParcelDesktop.MainWindow"
        Title="Parcel C++"
        Width="1400"
        Height="850"
        MinWidth="1050"
        MinHeight="650"
        Background="#1E1F22"
        Foreground="#D7D9DE">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#303236"/>
            <Setter Property="Foreground" Value="#E3E5E8"/>
            <Setter Property="BorderBrush" Value="#45484E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#41444B"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#25262A"/>
            <Setter Property="Foreground" Value="#E4E6EA"/>
            <Setter Property="BorderBrush" Value="#44474D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#25262A"/>
            <Setter Property="BorderBrush" Value="#44474D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#1E1F22"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#AEB2BA"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#303236"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- C++ MainWindow menu and toolbar parity -->
        <Menu Grid.Row="0" Background="#25262A" Foreground="#D7D9DE">
            <MenuItem Header="_File">
                <MenuItem Header="New Project" Click="OnNavDashboard"/>
                <MenuItem Header="Open Project" Click="OnNavExplorer"/>
                <MenuItem Header="Settings" Click="OnNavSettings"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Workspace" Click="OnNavExplorer"/>
                <MenuItem Header="Terminal" Click="OnNavTerminal"/>
                <MenuItem Header="Browser" Click="OnNavBrowser"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About Parcel"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#303236" BorderBrush="#45484E" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New Project" Click="OnNavDashboard"/>
                <Button Content="Open" Click="OnNavExplorer"/>
                <Button Content="New PDF" Click="OnNavEditor"/>
                <Separator/>
                <Button Content="Save" Click="OnSaveFile"/>
                <Button Content="Build" Click="OnRunShell"/>
                <Button Content="Settings" Click="OnNavSettings"/>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#8F939C" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabControl">
            <!-- MainWindow stacked dashboard -->
            <TabItem Header="Dashboard">
                <Grid RowDefinitions="Auto,*" Margin="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Parcel C++" FontSize="28" FontWeight="Bold" Foreground="#F2F3F5"/>
                        <TextBlock Text="Project dashboard and workspace launcher." Foreground="#9A9EA7"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,28,0,0">
                        <Border Grid.Column="0" Background="#292B30" BorderBrush="#44474D" BorderThickness="1" Padding="18" Margin="0,0,8,8">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Open Project" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Open or create a project workspace and restore its session." Foreground="#9A9EA7" TextWrapping="Wrap"/>
                                <TextBox x:Name="WorkspacePathBox" Text="Workspace path..." Watermark="Project directory"/>
                                <Button Content="Open Workspace" Click="OnOpenWorkspace" Background="#3B6E67"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#292B30" BorderBrush="#44474D" BorderThickness="1" Padding="18" Margin="8,0,0,8">
                            <StackPanel Spacing="10">
                                <TextBlock Text="New Project" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Create an empty project directory using the current workspace flow." Foreground="#9A9EA7" TextWrapping="Wrap"/>
                                <Button Content="Create in entered path" Click="OnOpenWorkspace" Background="#3B6E67"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#25262A" BorderBrush="#44474D" BorderThickness="1" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Session restore" FontWeight="Bold"/>
                                <TextBlock Text="The last project and open file are restored when Parcel starts." Foreground="#9A9EA7"/>
                                <TextBlock Text="Use the toolbar or File menu to enter the workspace." Foreground="#777C86"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- C++ ProjectWorkspace: header + vertical splitter -->
            <TabItem Header="Project Workspace">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Background="#292B30" BorderBrush="#44474D" BorderThickness="0,0,0,1" Padding="10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <TextBlock Text="PROJECT WORKSPACE" FontWeight="Bold" Foreground="#DCE0E6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#8F939C"/>
                            <Button Grid.Column="2" Content="Gemini" Click="OnNavLLMClients" Margin="6,0,0,0"/>
                            <Button Grid.Column="3" Content="Designer" Click="OnToggleDesigner" Margin="6,0,0,0"/>
                            <Button Grid.Column="4" Content="Build" Click="OnRunShell" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="*,Auto">
                        <!-- C++ horizontal splitter: left tabs, editor, designer, east tabs -->
                        <Grid Grid.Row="0" ColumnDefinitions="250,*,0,360" Background="#1E1F22">
                            <TabControl Grid.Column="0" x:Name="LeftTabs" TabStripPlacement="Top">
                                <TabItem Header="Files">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
                                        <TextBlock Text="Package Explorer" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                                            <Button Content="Open" Click="OnOpenWorkspace" Padding="7,5"/>
                                            <Button Content="Refresh" Click="OnRefreshExplorer" Padding="7,5"/>
                                        </StackPanel>
                                        <ListBox Grid.Row="2" x:Name="PackageExplorerList" SelectionChanged="OnExplorerSelectionChanged" Margin="0,8"/>
                                        <TextBox Grid.Row="3" x:Name="FileInspectorBox" Text="File properties" IsReadOnly="True" AcceptsReturn="True" Height="90" FontSize="11"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="DBMS">
                                    <StackPanel Margin="8" Spacing="8">
                                        <TextBlock Text="Database explorer" FontWeight="Bold"/>
                                        <TextBlock Text="Select a database file in Files to open the SQLite console below." Foreground="#8F939C" TextWrapping="Wrap"/>
                                        <Button Content="Open database pane" Click="OnNavDatabase"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                                <Border Background="#25262A" Padding="7">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Open" Click="OnOpenFile" Padding="8,5"/>
                                        <Button Content="Save" Click="OnSaveFile" Background="#3B6E67" Padding="8,5"/>
                                        <Button Content="Save As" Click="OnSaveFile" Padding="8,5"/>
                                        <Button Content="New PDF" Click="OnNavEditor" Padding="8,5"/>
                                        <TextBlock x:Name="EditorModeText" Text="Code" Foreground="#8F939C" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TabControl Grid.Row="1" x:Name="EditorTabs">
                                    <TabItem Header="Welcome">
                                        <TextBox x:Name="CodeEditorBox" Text="// Open a file from the project explorer." AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas,Monospace" Background="#1B1C1F" BorderThickness="0" Padding="14"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Border Grid.Column="2" Background="#1E1F22"/>

                            <TabControl Grid.Column="3" x:Name="EastTabs">
                                <TabItem Header="Gemini">
                                    <StackPanel Margin="10" Spacing="8">
                                        <TextBlock Text="Gemini" FontWeight="Bold"/>
                                        <TextBox x:Name="GeminiInput" Text="Prompt for Gemini." AcceptsReturn="True" Height="70"/>
                                        <Button Content="Send" Click="OnSendGemini"/>
                                        <TextBox x:Name="GeminiOutput" Text="Provider status." IsReadOnly="True" AcceptsReturn="True" Height="190"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="OpenAI">
                                    <StackPanel Margin="10" Spacing="8">
                                        <TextBlock Text="OpenAI" FontWeight="Bold"/>
                                        <TextBox x:Name="OpenAIInput" Text="Prompt for OpenAI." AcceptsReturn="True" Height="70"/>
                                        <Button Content="Send" Click="OnSendOpenAI"/>
                                        <TextBox x:Name="OpenAIOutput" Text="Provider status." IsReadOnly="True" AcceptsReturn="True" Height="190"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Shell">
                                    <Grid RowDefinitions="*,Auto" Margin="10">
                                        <TextBox x:Name="ShellOutputBox" Text="Shell output." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Monospace"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                            <TextBox x:Name="ShellInputBox" Text="dotnet --info"/>
                                            <Button Grid.Column="1" Content="Run" Click="OnRunShell" Background="#3B6E67"/>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Git">
                                    <Grid RowDefinitions="Auto,*" Margin="10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Status" Click="OnGitStatus"/>
                                            <Button Content="Log" Click="OnVersionsLog"/>
                                        </StackPanel>
                                        <TextBox Grid.Row="1" x:Name="GitOutputBox" Text="Git output." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Monospace" Margin="0,8,0,0"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- C++ bottomTabs: hidden in reference until a pane is requested -->
                        <TabControl Grid.Row="1" x:Name="BottomTabs" TabStripPlacement="Bottom" IsVisible="True" Height="190">
                            <TabItem Header="Google">
                                <StackPanel Margin="10" Spacing="8">
                                    <TextBlock Text="Browser integration is capability-gated in this Avalonia build." Foreground="#C99586"/>
                                    <TextBox x:Name="UrlInputBox" Text="https://www.google.com"/>
                                    <Button Content="Check URL" Click="OnNavigateUrl" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="BrowserOutputBox" Text="No navigation performed." IsReadOnly="True" AcceptsReturn="True"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Duck.ai"/>
                            <TabItem Header="Brave Leo"/>
                            <TabItem Header="ChatGPT"/>
                            <TabItem Header="ExplainShell"/>
                            <TabItem Header="Terminal">
                                <TextBox Text="Use the Shell pane on the right to run workspace commands." IsReadOnly="True" AcceptsReturn="True" Margin="10"/>
                            </TabItem>
                            <TabItem Header="SS AI Agent">
                                <Grid RowDefinitions="*,Auto" Margin="10">
                                    <TextBox x:Name="AgentOutputBox" Text="Ready." IsReadOnly="True" AcceptsReturn="True"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBox x:Name="AgentInputBox" Text="Analyze this workspace."/>
                                        <Button Grid.Column="1" Content="Run" Click="OnRunAgent" Background="#3B6E67"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Problems">
                                <TextBox x:Name="FrameworkOutputBox" Text="Inspection capabilities are not connected to a native diagnostics backend." IsReadOnly="True" AcceptsReturn="True" Margin="10"/>
                            </TabItem>
                            <TabItem Header="Database">
                                <Grid RowDefinitions="Auto,*" Margin="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="SqlInputBox" Text="SELECT * FROM Settings;"/>
                                        <Button Grid.Column="1" Content="Run SQL" Click="OnRunSql" Background="#3B6E67"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" x:Name="SqlOutputBox" Text="SQL output." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Monospace" Margin="0,8,0,0"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Logs"/>
                            <TabItem Header="Versions">
                                <TextBox Text="Use Git Log for repository history. File save history is available through backups." IsReadOnly="True" AcceptsReturn="True" Margin="10"/>
                            </TabItem>
                            <TabItem Header="Saves">
                                <Grid RowDefinitions="Auto,*" Margin="10">
                                    <Button Content="Backup selected file" Click="OnCreateBackup" HorizontalAlignment="Left" Background="#3B6E67"/>
                                    <TextBox Grid.Row="1" x:Name="BackupOutputBox" Text="Backup output." IsReadOnly="True" AcceptsReturn="True" Margin="0,8,0,0"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="24" Spacing="10">
                    <TextBlock Text="Parcel Settings" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Framework integrations expose their actual availability instead of claiming unsupported features." Foreground="#9A9EA7" TextWrapping="Wrap"/>
                    <Button Content="Inspect .NET runtime" Click="OnDotNet" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#25262A" BorderBrush="#45484E" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Ready" Foreground="#8F939C"/>
                <TextBlock Grid.Column="1" Text=".NET 8 | Avalonia" Foreground="#8F939C"/>
            </Grid>
        </Border>
    </Grid>
</Window>
